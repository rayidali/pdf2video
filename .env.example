# ---- required ----
ANTHROPIC_API_KEY=sk-ant-...
# Kodisc v2 key from https://kodisc.com/developer (starts with kdsc_live_; old kodisc_ keys are dead)
KODISC_API_KEY=kdsc_live_...
ELEVENLABS_API_KEY=...
# Cloudflare R2 (S3-compatible). The bucket can stay private: the app mints presigned URLs.
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET_NAME=...
SHOTSTACK_API_KEY=...
# v1 = production (no watermark, 20 free min/month), stage = unlimited sandbox with watermark
SHOTSTACK_ENV=v1

# ---- optional ----
# Only used when a PDF looks scanned; born-digital PDFs are read with pypdf for free.
MISTRAL_API_KEY=
# Set by the Vercel Marketplace Postgres integration. Leave unset locally to use SQLite.
# DATABASE_URL=postgres://...
# Protects the demo: every POST must send header X-Passcode with this value.
RUN_PASSCODE=
# Landing-page gallery. Entries have a title plus either an R2 "key" (presigned on read) or a public "url".
SAMPLE_VIDEOS=[]
MAX_UPLOAD_MB=25
PLAN_MODEL=claude-opus-5
CODE_MODEL=claude-opus-5
KODISC_QUALITY=medium
ELEVENLABS_VOICE_ID=pqHfZKP75CvOlQylNhV4
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
